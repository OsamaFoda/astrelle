# $name: the workspace; $tabs: how many tabs it has; $heir: where they go.
astrelle-workspace-delete-prompt =
    { $tabs ->
        [one] Delete "{ $name }"? Its { $tabs } tab will move to "{ $heir }".
       *[other] Delete "{ $name }"? Its { $tabs } tabs will move to "{ $heir }".
    }
